  <resources minRequiredRevision="1.0" />
  <supportedOn>
    <definitions>
      <definition name="SUPPORTED_1_23" displayName="$(string.SUPPORTED_1_23)" />
      <definition name="SUPPORTED_1_24" displayName="$(string.SUPPORTED_1_24)" />
      <definition name="SUPPORTED_1_25" displayName="$(string.SUPPORTED_1_25)" />
